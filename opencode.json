{
  "$schema": "https://opencode.ai/config.json",
  "model": "llamacpp/local-model",
  "modalities": [
    "text",
    "image"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "buffer": "20%",
    "keep": {
      "tokens": 16000
    }
  },
  "providers": {
    "llamacpp": {
      "name": "llama.cpp",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:9931/v1"
      },
      "models": {
        "local-model": {
          "modelID": "Qwen3.6-35B-A3B-GGUF",
          "capabilities": {
            "tools": true,
            "input": ["text","image"],
            "output": ["text"]
          },
          "limit": {
            "context": 98304,
            "output": 16384
          }
        }
      }
    }
  }
}
